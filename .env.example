# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Quran Foundation (credentials from https://api-docs.quran.foundation)
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
QURAN_FOUNDATION_ENV=prelive
VITE_APP_NAME="Quran Reader"
MAIL_MAILER=smtp
MAIL_FROM_NAME="Quran Reader"
MAIL_BRAND_NAME="Quran Reader"
MAIL_FROM_ADDRESS=app@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025
LIMITER_STORE=database

# Passkeys (PASSKEY_RP_ID must not change once users register passkeys)
PASSKEY_RP_ID=${HOST}
PASSKEY_ORIGINS=${APP_URL}
