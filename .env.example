# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database: sqlite (local file, default) or libsql (Turso, production)
DB_CONNECTION=sqlite
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Session
SESSION_DRIVER=cookie

# Quran Foundation (credentials from https://api-docs.quran.foundation)
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
QURAN_FOUNDATION_ENV=prelive
VITE_APP_NAME="Quran Reader"
MAIL_MAILER=smtp
MAIL_FROM_NAME="Quran Reader"
MAIL_BRAND_NAME="Quran Reader"
MAIL_FROM_ADDRESS=app@yourdomain.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Set MAIL_MAILER=resend and this key in production
RESEND_API_KEY=
LIMITER_STORE=database
# database (default) or redis; redis needs REDIS_URL
CACHE_STORE=database
# REDIS_URL=redis://127.0.0.1:6379

# Passkeys (PASSKEY_RP_ID must not change once users register passkeys)
PASSKEY_RP_ID=${HOST}
PASSKEY_ORIGINS=${APP_URL}
