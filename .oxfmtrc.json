{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".adonisjs",
    "astryx-themes.ts",
    "src/themes/quran/quran.js",
    "src/themes/quran/quran.css",
    "src/themes/quran/*.d.ts",
    "src/themes/quran/tokens",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    ".claude/CLAUDE.md"
  ]
}
