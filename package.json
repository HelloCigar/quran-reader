{
  "name": "quran-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "test:shards": "node --import=@poppinss/ts-exec bin/test_shards.ts",
    "lint": "node lint/sync_flow_overrides.js --check && vp lint",
    "lint:flow": "node lint/sync_flow_overrides.js",
    "format": "vp fmt",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "format:check": "vp fmt --check",
    "doctor": "npx react-doctor@latest",
    "prepare": "vp hooks enable || exit 0"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#values/*": "./app/values/*.js",
    "#ayah_block/*": "./app/ayah_block/*.js",
    "#ayah_reference/*": "./app/ayah_reference/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#types/*": "./types/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-ast-grep": "^1.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@adonisplus/flow": "^1.0.0",
    "@astryxdesign/cli": "^0.7.14",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "hot-hook": "^1.0.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.65.0",
    "railway": "^3.17.0",
    "react-doctor": "^0.9.23",
    "typescript": "~6.0.3",
    "unplugin": "^2.3.11",
    "vite": "^8.3.0",
    "vite-plus": "1.6.0",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.2",
    "@adonisplus/persona": "^0.4.2",
    "@astryxdesign/core": "^0.7.14",
    "@astryxdesign/theme-neutral": "^0.7.14",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/react": "^3.7.1",
    "@libsql/sqlite3": "^0.3.1",
    "@quranjs/api": "^3.17.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "mjml": "^5.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "browserslist": [
    "chrome >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ]
}
