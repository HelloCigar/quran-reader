{{--
  The color mode the user picked with the theme toggle (`app_theme` cookie),
  applied before any JavaScript runs so the page never flashes the wrong mode.
  Without a choice, the browser follows the operating system.
--}}
@let(theme = request.plainCookie('app_theme', { encoded: false }))
<!DOCTYPE html>
<html lang="en" style="color-scheme: {{ theme === 'dark' ? 'dark' : theme === 'light' ? 'light' : 'light dark' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title data-inertia>
      Quran Reader
    </title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {{--
      Browser chrome color: the theme's --color-background-body, copied from
      the palette (sand light 95 / dark 10) because a meta tag cannot read
      tokens. Follows the same cookie choice as color-scheme above.
    --}}
    @if(theme === 'dark')
      <meta name="theme-color" content="#1f1b14" />
    @elseif(theme === 'light')
      <meta name="theme-color" content="#f6f0e7" />
    @else
      <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f0e7" />
      <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1f1b14" />
    @end

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
