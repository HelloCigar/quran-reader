@emailLayout({ title })
  <mj-section>
    <mj-column>
      <mj-text mj-class="title">Update email address</mj-text>
      <mj-spacer height="30px" />
      <mj-text mj-class="text">
        Follow this link to confirm the update of your email address from
        {{ oldEmail }}
        to
        {{ newEmail }}:
      </mj-text>
      <mj-spacer height="15px" />
      <mj-button href="{{ verificationLink }}">Verify your email address</mj-button>
      <mj-spacer height="15px" />
      <mj-text mj-class="help">
        If you didn't request this email, there's no need to worry. You can safely ignore it.
      </mj-text>
      <mj-spacer height="8px" />
      <mj-text mj-class="help">
        To keep your account secure, please don't forward this email to anyone.
      </mj-text>
    </mj-column>
  </mj-section>
@end
