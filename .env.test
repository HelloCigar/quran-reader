# Tests start their own HTTP server; keep it off the dev server's port.
# Test shards (`npm run test:shards`) set PORT for each process.
PORT=3334
APP_URL=http://localhost:${PORT}

SESSION_DRIVER=memory

# Tests replace QuranTextService with a fake, so these are never sent.
QURAN_FOUNDATION_CLIENT_ID=test
QURAN_FOUNDATION_CLIENT_SECRET=test
QURAN_FOUNDATION_ENV=prelive

VITE_APP_NAME="Quran Reader"

# Passkeys: the domain comes from .env; the origin follows the test server's own URL.
PASSKEY_ORIGINS=${APP_URL}
